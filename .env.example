# Copiar a apps/api/.env y apps/worker/.env.

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://xxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json

# Conexión TCP directa a Postgres para pg-boss. El pooler en modo transacción NO
# sirve: desactiva LISTEN/NOTIFY, que es de lo que vive pg-boss.
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

# --- Cifrado de credenciales de cliente ---
# 32 bytes en base64: openssl rand -base64 32
CREDENTIALS_MASTER_KEY=

# --- API ---
PORT=3000
CORS_ORIGINS=http://localhost:4100
# La estampa el deploy; en local cae al version del package.json.
APP_VERSION=

# --- Web (apps/web/.env) ---
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_API_URL=http://localhost:3000/api
