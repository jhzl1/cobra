# Copiar a apps/api/.env

NODE_ENV=development
PORT=3000
# Separados por coma. Es el origen del panel, no el de la API.
CORS_ORIGINS=http://localhost:4100

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Singular, no plural: @supabase/server lee SUPABASE_PUBLISHABLE_KEYS primero y la
# parsea como JSON, y un valor que no lo sea se traga sin error y resuelve a cero
# llaves. La forma singular toma el valor tal cual lo da el dashboard.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Saltea RLS por completo. Solo backend, nunca el panel.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
# No se deriva de SUPABASE_URL: sin ella el adaptador se rinde antes de verificar
# nada y toda petición responde 401 con un token perfectamente válido.
SUPABASE_JWKS_URL=https://xxxxxxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json

# --- Postgres ---
# Conexión TCP directa, no el pooler: pg-boss vive de LISTEN/NOTIFY, que el pooler
# en modo transacción desactiva. Aquí solo encola.
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- Cifrado de credenciales de cliente ---
# 32 bytes en base64: openssl rand -base64 32
# Tiene que ser LA MISMA que la del worker, o el worker no puede descifrar lo que
# el panel guardó.
CREDENTIALS_MASTER_KEY=

# La estampa el deploy. En local cae al version del package.json.
APP_VERSION=
