{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=@cobra/api",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/turbo.json"
    ]
  },
  "deploy": {
    "startCommand": "node apps/api/dist/main.js",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
