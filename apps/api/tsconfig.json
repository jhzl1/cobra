{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    // Node16 so TypeScript honours the "exports" map in package.json — that is
    // how @supabase/server/adapters/nestjs resolves. No "type": "module" here,
    // so the output stays CommonJS, which is what NestJS expects.
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    // Required by ts-jest whenever module is Node16, and a good default anyway.
    "isolatedModules": true,

    "strict": true,
    "noFallthroughCasesInSwitch": true,
    // Nest injects through decorators, which tsc cannot see.
    "strictPropertyInitialization": false,

    "types": ["node", "jest"],

    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
