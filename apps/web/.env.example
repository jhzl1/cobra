# Copiar a apps/web/.env
#
# Todo lo que empiece por VITE_ queda dentro del bundle y lo lee cualquiera que
# abra el panel. Aquí nunca va una llave secreta.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# La publishable, la misma del api. Es la que el navegador usa para autenticarse y
# para suscribirse a Realtime; lo que puede leer lo deciden las políticas RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Con el prefijo /api incluido.
VITE_API_URL=http://localhost:3000/api

# No se configura en ningún lado: la escribe el deploy (deploy.yml) y se muestra
# en el encabezado del panel. En local cae al version del package.json. Dejarla
# vacía.
VITE_APP_VERSION=
