{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "noUncheckedSideEffectImports": true,

    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src", "src/vite-env.d.ts"]
}
