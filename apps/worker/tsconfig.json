{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    /**
     * NodeNext, and the package is "type": "module".
     *
     * @cobra/agent is ESM only because the AI SDK v7 publishes no CommonJS
     * build, and a CommonJS worker could not require it. The cost is that every
     * relative import in this app carries its .js extension, which is what
     * NodeNext demands of real ESM.
     */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "isolatedModules": true,

    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "strictPropertyInitialization": false,

    "types": ["node"],

    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
