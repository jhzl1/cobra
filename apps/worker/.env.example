# Copiar a apps/worker/.env

NODE_ENV=development

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# El worker no tiene sesión detrás: siempre corre con la llave secreta, y por eso
# cada consulta lleva su tenant_id (TenantScope en @cobra/data).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# --- Postgres ---
# Aquí pg-boss sí migra, supervisa y trabaja las colas, así que la conexión directa
# no es opcional.
#
# Primer deploy en Railway: falla con ENETUNREACH. La conexión directa de Supabase
# es solo IPv6 y Railway no trae IPv6 saliente por defecto — se activa en
# Settings → Networking → Outbound IPv6 y se redespliega.
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- Cifrado de credenciales de cliente ---
# LA MISMA que la del api.
CREDENTIALS_MASTER_KEY=

# Turnos simultáneos de este worker, sumando todos los clientes.
TURN_CONCURRENCY=4
