# Copiar a packages/db/.env
#
# Este no lo lee ninguna aplicación: lo leen los scripts del CLI de Supabase, que
# toman las variables del shell. Para usarlo:
#
#   set -a; source packages/db/.env; set +a
#
# o dejar que direnv lo cargue.

# El identificador del proyecto: lo que va antes de .supabase.co en la URL.
SUPABASE_PROJECT_ID=xxxxxxxxxxxx
