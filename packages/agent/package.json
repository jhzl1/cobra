  },
  "dependencies": {
    "@cobra/contracts": "workspace:*",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.102",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.6"
  }
}
